if __name__ == "__main__":
    # Define a simple racetrack map as a list of strings (you can save this in a file if you want)
    racetrack_map = [
        "############",
        "#        F##",
        "#        F##",
        "#        F##",
        "#        F##",
        "#SSSS    F##",
        "############"
    ]
    
    # Convert racetrack_map (list of strings) to a list of lists of integers
    racetrack_map_data = []
    mapping = {' ': 0, '#': 1, 'S': 2, 'F': 3}
    for line in racetrack_map:
        racetrack_map_data.append([mapping[char] for char in line])
    
    # Create the environment
    env = RacetrackEnv(racetrack_map_data)
    
    # Create the agent with possible actions (9 actions: increments in [-1, 0, 1] for each velocity component)
    possible_actions = env.get_possible_actions()
    agent = MCAgent(possible_actions)
    
    # Debug: Reset environment and render initial state
    state = env.reset()
    print("Initial state:", state)
    env.render()
    
    # Train the agent with off-policy Monte Carlo control
    num_episodes = 500
    agent.off_policy_mc_control(env, num_episodes, epsilon=0.1, discount=1.0)
    
    # Get and render optimal trajectory
    trajectory = agent.get_optimal_trajectory(env, num_steps=100)
    print("Optimal trajectory (states):")
    for st in trajectory:
        print(st)
    env.render()
    env.render_matplotlib(trajectory)
